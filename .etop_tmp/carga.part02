endarios({nrc,estado:'',fechaInicio:'',fechaDesde:'',fechaHasta:''})}
function abrirIntakeCalendario(intake){abrirCalendarios({intake,nrc:'',fechaInicio:''})}
function studentCount(x){return Number(metricMap.get(norm(x.nrc))||0)}
function uniqueVals(key){return [...new Set(courses.map(x=>String(x[key]??'').trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es',{numeric:true}))}
function fill(id,key,label){const e=document.getElementById(id),cur=e.value;e.innerHTML=`<option value="">${label}</option>`+uniqueVals(key).map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join('');if([...e.options].some(o=>o.value===cur))e.value=cur}
function fillTutor(){const e=document.getElementById('tutor'),cur=e.value;e.innerHTML='<option value="">Todos los tutores</option>'+TUTORES_ACTIVOS.map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join('');if(TUTORES_SET.has(norm(cur)))e.value=TUTORES_ACTIVOS.find(v=>norm(v)===norm(cur))||'';else e.value=''}
function rebuildFilters(){fill('facultad','facultad','Todas las facultades');fillTutor();fill('tipo','tipo','Todos los tipos NRC');fill('estado','estado','Todos los estados');fill('intake','intake','Todos los intake');fill('codigo','codigo curso','Todos los códigos')}
function filtered(ignoreTutor=false){const f={facultad:norm(facultad.value),tutor:norm(tutor.value),tipo:norm(tipo.value),estado:norm(estado.value),intake:norm(intake.value),codigo:norm(codigo.value),fecha:fecha.value};return courses.filter(x=>(!f.facultad||norm(x.facultad)===f.facultad)&&(ignoreTutor||!f.tutor||norm(x.tutor)===f.tutor)&&(!f.tipo||norm(x.tipo)===f.tipo)&&(!f.estado||norm(x.estado)===f.estado)&&(!f.intake||norm(x.intake)===f.intake)&&(!f.codigo||norm(x['codigo curso'])===f.codigo)&&(!f.fecha||String(x['fecha inicio']||'').slice(0,10)===f.fecha))}
function renderFacultyBars(facRows){const max=Math.max(1,...facRows.map(r=>r.att));facultyChart.innerHTML='';facLegend.innerHTML='';if(!facRows.length){facultyChart.innerHTML='<div class="empty" style="width:100%">Sin datos para los filtros seleccionados.</div>';return}facRows.forEach((row,i)=>{const h=Math.max(4,row.att/max*100),facEnc=encodeURIComponent(row.f);facultyChart.insertAdjacentHTML('beforeend',`<div class="faculty-col drill-item" title="Ver detalle en Calendarios" data-fac="${facEnc}"><div class="faculty-value">${num(row.att)}</div><div class="faculty-track"><div class="faculty-bar" style="height:${h}%;background:${colors[i%colors.length]}"></div></div><div class="faculty-short" title="${esc(row.f)}">${esc(row.f)}</div></div>`);facLegend.insertAdjacentHTML('beforeend',`<div class="legend-item drill-item" title="Ver detalle en Calendarios" data-fac="${facEnc}"><span class="dot" style="background:${colors[i%colors.length]}"></span><span class="legend-text"><strong>${esc(row.f)}</strong> · ${row.nrc} NRC · ${num(row.att)} estudiantes</span></div>`) });document.querySelectorAll('[data-fac]').forEach(el=>el.addEventListener('click',()=>abrirCalendarios({facultad:decodeURIComponent(el.dataset.fac)})))}
function courseList(items,mode){if(!items.length)return `<div class="empty">${mode==='future'?'No hay cursos por iniciar en los próximos 30 días.':'No hay cursos activos o en cierre para los filtros seleccionados.'}</div>`;return items.map(x=>{const nrcEnc=encodeURIComponent(x.nrc||'');if(mode==='current'){const st=norm(x.estado);return `<div class="mini-item drill-item" title="Abrir NRC en Calendarios" data-nrc="${nrcEnc}"><div class="datebox">${fmt(x['fecha inicio'])}<span>Inicio</span></div><div class="mini-main"><strong>${esc(x.nrc)}</strong><span class="current-meta"><span class="status-pill ${st==='ACTIVO'?'status-act':'status-close'}">${esc(x.estado)}</span><span class="meta-text">${esc(x['codigo curso']||'—')} · ${esc(x['nombre curso']||'')} · Fin ${fmt(x['fecha fin'])} · ${esc(x.tutor||'Sin tutor')}</span></span></div><div class="student-pill">${studentCount(x)} est.</div></div>`}const sub=days(x['fecha inicio'])===0?'HOY':`En ${days(x['fecha inicio'])} días`;return `<div class="mini-item drill-item" title="Abrir NRC en Calendarios" data-nrc="${nrcEnc}"><div class="datebox">${fmt(x['fecha inicio'])}<span>${sub}</span></div><div class="mini-main"><strong>${esc(x.nrc)}</strong><span>${esc(x['nombre curso']||'')} · ${esc(x.tutor||'Sin tutor')}</span></div><div class="student-pill">${studentCount(x)} est.</div></div>`}).join('')}
function tutorRowsFrom(data){const operational=data.filter(x=>['ACTIVO','EN CIERRE'].includes(norm(x.estado)));const map=new Map(TUTORES_ACTIVOS.map(t=>[norm(t),{t,act:0,cie:0,att:0}]));operational.forEach(x=>{const key=norm(x.tutor);if(!TUTORES_SET.has(key))return;const o=map.get(key);if(norm(x.estado)==='ACTIVO')o.act++;if(norm(x.estado)==='EN CIERRE')o.cie++;o.att+=studentCount(x)});return [...map.values()].sort((a,b)=>b.att-a.att||b.act-a.act||a.t.localeCompare(b.t,'es'))}
function render(){const data=filtered(false);const operational=data.filter(x=>['ACTIVO','EN CIERRE'].includes(norm(x.estado)));const att=operational.reduce((s,x)=>s+studentCount(x),0),activos=operational.filter(x=>norm(x.estado)==='ACTIVO').length,cierre=operational.filter(x=>norm(x.estado)==='EN CIERRE').length,prom=operational.length?att/operational.length:0;kAt.textContent=num(att);kTu.textContent=TUTORES_ACTIVOS.length;kAc.textContent=num(activos);kCi.textContent=num(cierre);kPr.textContent=num(prom);
const prep30=data.filter(x=>norm(x.estado)==='PREPARACION'&&days(x['fecha inicio'])>=0&&days(x['fecha inicio'])<=30);kPrep30.textContent=prep30.length;const programas30=new Set(prep30.filter(x=>norm(x['codigo curso'])==='UNI118').map(x=>String(x['nombre programa']||'').trim()).filter(Boolean));kProg.textContent=programas30.size;kProgCard.classList.toggle('hidden',programas30.size===0);
const listRows=tutorRowsFrom(filtered(true));const selectedTutor=norm(tutor.value);tutoresBody.innerHTML=listRows.map(r=>{const te=encodeURIComponent(r.t);return `<tr><td><button class="tutor-link ${selectedTutor===norm(r.t)?'active':''}" data-tutor="${esc(r.t)}">${esc(r.t)}</button></td><td class="num">${r.act?`<button class="metric-link" data-tutor-drill="${te}" data-estado-drill="ACTIVO" title="Ver cursos activos de ${esc(r.t)}">${r.act}</button>`:'0'}</td><td class="num">${r.cie?`<button class="metric-link" data-tutor-drill="${te}" data-estado-drill="EN CIERRE" title="Ver cursos en cierre de ${esc(r.t)}">${r.cie}</button>`:'0'}</td><td class="num"><button class="metric-link" data-tutor-all="${te}" title="Ver cursos operativos de ${esc(r.t)}"><strong>${num(r.att)}</strong></button></td><td class="num"><button class="metric-link" data-tutor-all="${te}" title="Ver cursos operativos de ${esc(r.t)}">${num(r.att/Math.max(1,r.act+r.cie))}</button></td></tr>`}).join('');
document.querySelectorAll('.tutor-link').forEach(b=>b.addEventListener('click',()=>{const val=b.dataset.tutor;tutor.value=(norm(tutor.value)===norm(val))?'':val;render()}));document.querySelectorAll('[data-tutor-drill]').forEach(b=>b.addEventListener(