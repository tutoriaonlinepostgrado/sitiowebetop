<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Carga Tutorial · ETOP</title>
<style>
:root{--navy:#1f2940;--navy2:#141b2d;--gold:#ffd700;--bg:#edf3f9;--card:#fff;--line:#d6e1ec;--text:#27364a;--muted:#64748b;--blue:#315f86;--green:#4f8a6d;--amber:#c28a16;--red:#c95d63;--purple:#7566a8}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:"Segoe UI",Tahoma,sans-serif;background:var(--bg);color:var(--text)}
.top{position:sticky;top:0;z-index:30;background:var(--navy);color:#fff;border-bottom:2px solid var(--gold);box-shadow:0 4px 18px rgba(15,23,42,.18)}
.top-main{min-height:56px;display:flex;align-items:center;gap:12px;padding:8px 18px}.brand{min-width:230px}.brand strong{display:block;color:var(--gold);font-size:14px;letter-spacing:.04em}.brand span{font-size:10px;color:#aeb9c7;text-transform:uppercase;letter-spacing:.12em}
.filters{display:flex;gap:7px;flex:1;flex-wrap:wrap}.filter{height:31px;min-width:118px;max-width:180px;border:1px solid rgba(255,255,255,.16);border-radius:8px;background:#27334c;color:#e6edf7;padding:0 9px;font-size:11px;outline:none}.filter:focus{border-color:var(--gold)}.filter option{background:#1f2940}.clear{height:31px;border-radius:8px;border:1px solid rgba(248,113,113,.35);background:rgba(239,68,68,.08);color:#fca5a5;padding:0 11px;font-size:10px;font-weight:700;cursor:pointer}
.wrap{padding:16px 18px 24px}.head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:12px}.head h1{margin:0;color:#173f61;font-size:24px;font-weight:650}.head p{margin:4px 0 0;color:var(--muted);font-size:11px}.updated{font-size:10px;color:var(--muted);text-align:right}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:10px;margin-bottom:12px}.kpi{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 14px;box-shadow:0 3px 12px rgba(49,95,134,.06)}.kpi small{display:block;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:7px}.kpi strong{display:block;font-size:27px;line-height:1;color:#173f61;font-weight:700}.kpi span{display:block;margin-top:6px;font-size:9px;color:var(--muted)}.kpi.hidden{display:none}.kpi.drill{cursor:pointer;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}.kpi.drill:hover{transform:translateY(-2px);border-color:#d6a900;box-shadow:0 6px 16px rgba(49,95,134,.12)}.drill-item{cursor:pointer}.drill-item:hover{background:#fffdf2!important}.faculty-col.drill-item:hover .faculty-short,.faculty-col.drill-item:hover .faculty-value{color:#8a6f00}.legend-item.drill-item:hover .legend-text{color:#8a6f00}.metric-link{border:0;background:transparent;color:#315f86;font:inherit;font-weight:800;cursor:pointer;padding:2px 4px;border-radius:5px}.metric-link:hover{background:#fff8dc;color:#7a6100;text-decoration:underline}.summary-drill{cursor:pointer;border-radius:8px;padding-left:6px!important;padding-right:6px!important}.summary-drill:hover{background:#fffdf2}.summary-drill:hover strong{color:#8a6f00}
.grid{display:grid;grid-template-columns:1.05fr 1fr;gap:12px;margin-bottom:12px}.card{background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 3px 12px rgba(49,95,134,.06);overflow:hidden}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:13px 14px 10px;border-bottom:1px solid var(--line)}.card-head h2{margin:0;color:#173f61;font-size:14px}.card-head p{margin:3px 0 0;font-size:10px;color:var(--muted)}
.table-wrap{overflow:auto;max-height:400px}table{width:100%;border-collapse:collapse;font-size:10px}th{position:sticky;top:0;background:#e1ebf4;color:#475569;text-transform:uppercase;font-size:8px;letter-spacing:.05em;text-align:left;padding:8px;border-bottom:1px solid #b8c8d8}td{padding:8px;border-bottom:1px solid #e8eef5;vertical-align:middle}tbody tr:hover td{background:#f7fafc}.num{text-align:right;font-variant-numeric:tabular-nums}.empty{padding:28px;text-align:center;color:var(--muted);font-size:11px}.tutor-link{background:none;border:0;padding:0;color:#173f61;font:inherit;font-weight:700;cursor:pointer;text-align:left}.tutor-link:hover{text-decoration:underline;color:#315f86}.tutor-link.active{color:#8a6f00}
.tabs{display:flex;gap:4px;padding:10px 12px 0;border-bottom:1px solid var(--line);background:#f8fafc}.tab-btn{border:0;background:transparent;color:#64748b;padding:8px 12px;font-size:10px;font-weight:800;cursor:pointer;border-bottom:3px solid transparent}.tab-btn.active{color:#173f61;border-bottom-color:var(--gold)}.tab-panel{display:none;padding:12px}.tab-panel.active{display:block}
.mini-item{display:grid;grid-template-columns:86px 1fr auto;gap:9px;align-items:center;padding:9px 0;border-bottom:1px solid #edf2f7}.mini-item:last-child{border-bottom:0}.datebox{font-size:10px;font-weight:700;color:#173f61}.datebox span{display:block;font-size:8px;color:var(--muted);font-weight:600}.mini-main{min-width:0}.mini-main strong{display:block;font-size:10px;color:#334155}.mini-main span{display:block;font-size:9px;color:var(--muted);margin-top:2px}.current-meta{display:flex!important;align-items:center;gap:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:20px;height:20px}.current-meta .meta-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.student-pill{font-size:9px;font-weight:800;color:#315f86;background:#e8f1f8;border-radius:999px;padding:4px 7px;white-space:nowrap}.status-pill{font-size:8px;font-weight:800;padding:2px 6px;border-radius:999px;display:inline-flex;align-items:center;flex:0 0 auto}.status-act{background:#dcfce7;color:#166534}.status-close{background:#fef3c7;color:#92400e}
.fac-wrap{min-height:330px;display:flex;flex-direction:column}.faculty-chart{height:235px;display:flex;align-items:flex-end;gap:14px;padding:15px 10px 8px;border-bottom:1px solid #edf2f7;overflow-x:auto}.faculty-col{height:100%;min-width:54px;flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center}.faculty-value{font-size:9px;font-weight:800;color:#173f61;margin-bottom:5px}.faculty-track{height:185px;width:100%;max-width:58px;display:flex;align-items:flex-end;justify-content:center;background:linear-gradient(to top,#f8fafc,#fff);border-bottom:1px solid #cbd5e1;border-radius:8px 8px 0 0}.faculty-bar{width:72%;min-height:4px;border-radius:7px 7px 0 0;transition:height .25s ease}.faculty-short{font-size:8px;color:#64748b;font-weight:700;margin-top:5px;max-width:74px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}.legend{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 14px;padding:10px 4px 0}.legend-item{display:flex;align-items:center;gap:7px;font-size:9px;color:#334155;min-width:0}.dot{width:9px;height:9px;border-radius:2px;flex:0 0 auto}.legend-item strong{color:#173f61}.legend-text{white-space:normal;line-height:1.25}
.