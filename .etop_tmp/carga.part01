bottom{display:grid;grid-template-columns:1.25fr .75fr;gap:12px}.badge{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;font-size:8px;font-weight:800}.uni{background:#ede9fe;color:#6d28d9}.error{margin:16px;padding:12px;background:#fff1f2;border:1px solid #fecdd3;color:#9f1239;border-radius:10px;font-size:11px}
body.embedded .top{display:none}.embedded .wrap{padding-top:10px}
@media(max-width:1100px){.grid,.bottom{grid-template-columns:1fr}.top-main{align-items:flex-start;flex-wrap:wrap}.brand{min-width:180px}.filters{width:100%}}
@media(max-width:650px){.kpis{grid-template-columns:1fr 1fr}.wrap{padding:12px}.head{align-items:flex-start;flex-direction:column}.filter{flex:1 1 140px;max-width:none}.tabs{overflow-x:auto}.tab-btn{white-space:nowrap}.legend{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="top"><div class="top-main"><div class="brand"><strong>ETOP · Carga Tutorial</strong><span>Coordinación · asignación y monitoreo</span></div><div class="filters"><select id="facultad" class="filter"><option value="">Todas las facultades</option></select><select id="tutor" class="filter"><option value="">Todos los tutores</option></select><select id="tipo" class="filter"><option value="">Todos los tipos NRC</option></select><select id="estado" class="filter"><option value="">Todos los estados</option></select><select id="intake" class="filter"><option value="">Todos los intake</option></select><select id="codigo" class="filter"><option value="">Todos los códigos</option></select><input id="fecha" class="filter" type="date" title="Fecha de inicio"><button id="clear" class="clear">Limpiar filtros</button></div></div></header>
<main class="wrap"><div class="head"><div><h1>Carga Tutorial</h1><p>Distribución actual de cursos y estudiantes por tutor, con foco en próximos inicios y nuevos intake.</p></div><div id="updated" class="updated">Cargando datos…</div></div>
<div class="kpis">
<div class="kpi"><small>Total atenciones</small><strong id="kAt">—</strong><span>Estudiantes acumulados en los NRC filtrados</span></div>
<div class="kpi"><small>Tutores activos</small><strong id="kTu">—</strong><span>Equipo tutorial activo actual</span></div>
<div id="kAcCard" class="kpi drill" title="Ver cursos activos en Calendarios"><small>Cursos activos</small><strong id="kAc">—</strong><span>NRC actualmente activos</span></div>
<div id="kCiCard" class="kpi drill" title="Ver cursos en cierre en Calendarios"><small>Cursos en cierre</small><strong id="kCi">—</strong><span>NRC en etapa de cierre</span></div>
<div class="kpi"><small>Promedio estudiantes / NRC</small><strong id="kPr">—</strong><span>Carga media por curso considerado</span></div>
<div id="kProgCard" class="kpi hidden drill" title="Ver programas por iniciar en Calendarios"><small>Programas por iniciar</small><strong id="kProg">—</strong><span>Programas con UNI118 dentro de 30 días</span></div>
<div id="kPrep30Card" class="kpi drill" title="Ver preparación de próximos 30 días en Calendarios"><small>Preparación próximos 30 días</small><strong id="kPrep30">—</strong><span>Cursos en preparación que comienzan dentro de 30 días</span></div>
</div>
<div class="grid"><section class="card"><div class="card-head"><div><h2>Carga actual por tutor</h2><p>Haz clic en el nombre de un tutor para ver su información a la derecha.</p></div></div><div class="table-wrap"><table><thead><tr><th>Tutor/a</th><th class="num">Activos</th><th class="num">En cierre</th><th class="num">Atenciones</th><th class="num">Promedio / NRC</th></tr></thead><tbody id="tutoresBody"></tbody></table></div></section>
<section class="card"><div class="tabs"><button class="tab-btn active" data-tab="facultadTab">Carga por facultad</button><button class="tab-btn" data-tab="proximosTab">Próximos cursos</button><button class="tab-btn" data-tab="actualTab">Carga actual</button></div><div id="facultadTab" class="tab-panel active"><div class="fac-wrap"><div id="facultyChart" class="faculty-chart"></div><div id="facLegend" class="legend"></div></div></div><div id="proximosTab" class="tab-panel"><div id="proximos"></div></div><div id="actualTab" class="tab-panel"><div id="actualCursos"></div></div></section></div>
<div class="bottom"><section class="card"><div class="card-head"><div><h2>Nuevos intake</h2><p>Solo UNI118: cada registro representa el inicio de una nueva cohorte.</p></div></div><div class="table-wrap"><table><thead><tr><th>Intake</th><th>Programa</th><th>Fecha inicio</th><th>Tutor/a</th><th class="num">Estudiantes</th><th>NRC</th></tr></thead><tbody id="intakesBody"></tbody></table></div></section><section class="card"><div class="card-head"><div><h2>Resumen operativo</h2><p>Datos útiles para decidir nuevas asignaciones.</p></div></div><div id="resumen" style="padding:8px 12px 12px"></div></section></div><div id="msg"></div></main>
<script>
const norm=v=>String(v??'').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const fmt=v=>{if(!v)return'—';const d=new Date(String(v).slice(0,10)+'T12:00:00');return isNaN(d)?String(v):d.toLocaleDateString('es-CL')};
const num=v=>new Intl.NumberFormat('es-CL',{maximumFractionDigits:1}).format(Number(v)||0);
const days=v=>{if(!v)return 99999;const a=new Date();a.setHours(0,0,0,0);const b=new Date(String(v).slice(0,10)+'T00:00:00');return Math.round((b-a)/86400000)};
const colors=['#315f86','#4f8a6d','#c28a16','#7566a8','#c95d63','#5f7f9a','#8a6f4d','#5c8f86'];
const TUTORES_ACTIVOS=['HANS NOVAKOVIC','KIMBERLY JORQUERA','MARTA GONZALEZ','DANITZA JANSEN','SYLVIA VALENZUELA','PAULA PARDO','MARIA FERNANDA GONZALEZ','BARBARA ROJAS','CONSTANZA CONTRERAS','CARLA PEÑA','NOEMI PAZ','HECTOR TAPIA','CONSUELO PARGA','FRANCISCA INDA','JAVIERA ROJAS','ALYSON HERNANDEZ'];
const TUTORES_SET=new Set(TUTORES_ACTIVOS.map(norm));
let courses=[],metrics=[],metricMap=new Map();
if(new URLSearchParams(location.search).get('embedded')==='1')document.body.classList.add('embedded');
function isoToday(){const d=new Date();d.setHours(0,0,0,0);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function addDaysISO(n){const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()+n);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function abrirCalendarios(extra={}){const params=new URLSearchParams();params.set('origen','carga_tutorial');const base={facultad:facultad.value,tutor:tutor.value,tipo:tipo.value,estado:estado.value,intake:intake.value,codigo:codigo.value,fechaInicio:fecha.value};Object.entries(base).forEach(([k,v])=>{if(String(v||'').trim())params.set(k,v)});Object.entries(extra).forEach(([k,v])=>{if(v===null||v===undefined||v==='')params.delete(k);else params.set(k,v)});location.href=`calendarios.html?${params.toString()}`}
function abrirNrcCalendario(nrc){abrirCal