'click',()=>abrirCalendarios({tutor:decodeURIComponent(b.dataset.tutorDrill),estado:b.dataset.estadoDrill,nrc:'',fechaInicio:''})));document.querySelectorAll('[data-tutor-all]').forEach(b=>b.addEventListener('click',()=>abrirCalendarios({tutor:decodeURIComponent(b.dataset.tutorAll),estado:'ACTIVO|EN CIERRE',nrc:'',fechaInicio:''})));
const byFac=new Map();operational.forEach(x=>{const f=String(x.facultad||'SIN FACULTAD').trim()||'SIN FACULTAD';if(!byFac.has(f))byFac.set(f,{f,att:0,nrc:0});const o=byFac.get(f);o.att+=studentCount(x);o.nrc++});renderFacultyBars([...byFac.values()].sort((a,b)=>b.att-a.att));
const prox=prep30.slice().sort((a,b)=>days(a['fecha inicio'])-days(b['fecha inicio'])).slice(0,12);proximos.innerHTML=courseList(prox,'future');
const current=operational.slice().sort((a,b)=>String(a['fecha inicio']||'').localeCompare(String(b['fecha inicio']||''))||String(a.nrc).localeCompare(String(b.nrc))).slice(0,12);actualCursos.innerHTML=courseList(current,'current');document.querySelectorAll('[data-nrc]').forEach(el=>el.addEventListener('click',()=>abrirNrcCalendario(decodeURIComponent(el.dataset.nrc))));
const intakes=data.filter(x=>norm(x['codigo curso'])==='UNI118'&&days(x['fecha inicio'])>=0).sort((a,b)=>days(a['fecha inicio'])-days(b['fecha inicio']));intakesBody.innerHTML=intakes.length?intakes.map(x=>`<tr><td><button class="tutor-link" title="Ver intake en Calendarios" data-intake="${encodeURIComponent(x.intake||'')}"><span class="badge uni">${esc(x.intake||'—')}</span></button></td><td>${esc(x['nombre programa']||'—')}</td><td>${fmt(x['fecha inicio'])}</td><td>${esc(x.tutor||'Sin tutor')}</td><td class="num">${studentCount(x)}</td><td><button class="tutor-link" title="Abrir NRC en Calendarios" data-nrc-table="${encodeURIComponent(x.nrc||'')}">${esc(x.nrc||'—')}</button></td></tr>`).join(''):'<tr><td colspan="6" class="empty">No hay nuevos intake UNI118 próximos con estos filtros.</td></tr>';document.querySelectorAll('[data-intake]').forEach(el=>el.addEventListener('click',()=>abrirIntakeCalendario(decodeURIComponent(el.dataset.intake))));document.querySelectorAll('[data-nrc-table]').forEach(el=>el.addEventListener('click',()=>abrirNrcCalendario(decodeURIComponent(el.dataset.nrcTable))));
const rows=tutorRowsFrom(data).filter(r=>r.act+r.cie>0),noTutor=operational.filter(x=>!String(x.tutor||'').trim()).length,cero=operational.filter(x=>studentCount(x)===0).length,mas30=operational.filter(x=>studentCount(x)>30).length,top=rows[0];resumen.innerHTML=`<div class="mini-item summary-drill" data-vista="sinTutor" title="Ver cursos sin tutor en Calendarios"><div class="datebox">${noTutor}</div><div class="mini-main"><strong>Cursos sin tutor</strong><span>NRC activos o en cierre sin asignación</span></div></div><div class="mini-item summary-drill" data-vista="ceroEstudiantes" title="Ver cursos con 0 estudiantes en Calendarios"><div class="datebox">${cero}</div><div class="mini-main"><strong>Cursos con 0 estudiantes</strong><span>Revisar si corresponde a curso aún sin nómina</span></div></div><div class="mini-item summary-drill" data-vista="mas30" title="Ver cursos con más de 30 estudiantes en Calendarios"><div class="datebox">${mas30}</div><div class="mini-main"><strong>Cursos con más de 30 estudiantes</strong><span>Posibles cargas altas por NRC</span></div></div><div class="mini-item ${top?'summary-drill':''}" ${top?`data-top-tutor="${encodeURIComponent(top.t)}" title="Ver cursos de ${esc(top.t)} en Calendarios"`:''}><div class="datebox">${top?num(top.att):0}</div><div class="mini-main"><strong>Mayor carga actual</strong><span>${top?esc(top.t):'Sin datos'}</span></div></div>`;document.querySelectorAll('[data-vista]').forEach(el=>el.addEventListener('click',()=>abrirCalendarios({vista:el.dataset.vista,estado:'',nrc:'',fechaInicio:''})));document.querySelectorAll('[data-top-tutor]').forEach(el=>el.addEventListener('click',()=>abrirCalendarios({tutor:decodeURIComponent(el.dataset.topTutor),estado:'ACTIVO|EN CIERRE',nrc:'',fechaInicio:''})));}
kAcCard.addEventListener('click',()=>abrirCalendarios({estado:'ACTIVO',fechaDesde:'',fechaHasta:''}));
kCiCard.addEventListener('click',()=>abrirCalendarios({estado:'EN CIERRE',fechaDesde:'',fechaHasta:''}));
kPrep30Card.addEventListener('click',()=>abrirCalendarios({estado:'PREPARACION',fechaInicio:'',fechaDesde:isoToday(),fechaHasta:addDaysISO(30)}));
kProgCard.addEventListener('click',()=>abrirCalendarios({estado:'PREPARACION',codigo:'UNI118',fechaInicio:'',fechaDesde:isoToday(),fechaHasta:addDaysISO(30)}));
['facultad','tutor','tipo','estado','intake','codigo','fecha'].forEach(id=>document.getElementById(id).addEventListener('change',render));clear.addEventListener('click',()=>{['facultad','tutor','tipo','estado','intake','codigo','fecha'].forEach(id=>document.getElementById(id).value='');render()});document.querySelectorAll('.tab-btn').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab-panel').forEach(x=>x.classList.remove('active'));btn.classList.add('active');document.getElementById(btn.dataset.tab).classList.add('active')}));
Promise.all([fetch(`nrcs.json?v=${Date.now()}`,{cache:'no-store'}),fetch(`metricas_estudiantes.json?v=${Date.now()}`,{cache:'no-store'})]).then(async([nr,mr])=>{if(!nr.ok)throw new Error('No fue posible leer nrcs.json');courses=await nr.json();metrics=mr.ok?await mr.json():[];metricMap=new Map(metrics.map(i=>[norm(i.nrc),Number(i.total_estudiantes)||0]));rebuildFilters();render();const stamp=metrics.map(x=>x.actualizado).filter(Boolean).sort().pop();updated.textContent=stamp?`Métricas actualizadas: ${new Date(stamp).toLocaleString('es-CL')}`:'Datos cargados desde GitHub'}).catch(e=>{msg.innerHTML=`<div class="error">${esc(e.message)}</div>`;updated.textContent='Error de carga'});
</script>
</body>
</html>