r;transition:.15s}
    .course-meta-filter:hover{border-color:#d6a900;background:#fffdf2}
    .course-meta-filter.active{border-color:#d6a900;background:#fff8dc;box-shadow:0 0 0 2px rgba(214,169,0,.08)}
    .course-meta-label{display:block;font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#7b8da2;margin-bottom:2px}
    .course-meta-value{display:block;font-size:10px;font-weight:700;color:#41566e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .course-meta-filter.active .course-meta-value{color:#725600}
    .course-filter-clear{width:100%;height:29px;margin-top:7px;border:1px solid #efc1c5;border-radius:7px;background:#fff5f5;color:#a84d55;font-size:9px;font-weight:800;cursor:pointer}
    .powerapp-panel-view{height:calc(100vh - 250px);min-height:430px;display:flex;flex-direction:column}
    .powerapp-panel-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 10px;border-bottom:1px solid #e2e8f0;background:#f8fafc}
    .powerapp-back{height:29px;padding:0 9px;border:1px solid #c7d5e2;border-radius:7px;background:#fff;color:#52657a;font-size:9px;font-weight:800;cursor:pointer}
    .powerapp-external{font-size:9px;font-weight:700;color:#315f86;text-decoration:none}
    .powerapp-iframe{width:100%;flex:1;border:0;background:#fff}
    .powerapp-open-note{font-size:9px;color:#64748b;padding:0 10px 8px}
    @media(max-width:1100px){
      .course-panel{position:fixed;top:12px;right:12px;bottom:12px;z-index:60;width:min(390px,calc(100vw - 24px));max-height:none;box-shadow:0 18px 45px rgba(15,23,42,.24)}
    }
</style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body>
  <div id="drill-context" class="drill-context"><div class="drill-context-main"><strong>Detalle desde Carga Tutorial</strong><div id="drill-context-text" class="drill-context-text"></div></div><button type="button" class="drill-back" onclick="volverCargaTutorial()">← Volver a Carga Tutorial</button></div>
  <section class="header">
    <div class="header-grid">
      <div class="h-label">👤 TUTOR/A</div><div class="h-value up" id="h-tutor">—</div>
      <div class="h-label">📚 PROGRAMA</div><div class="h-value" id="h-programa">—</div>
      <div class="h-label">📧 CORREO</div><div class="h-value" id="h-correo">—</div>
      <div class="h-label">💻 TIPO NRC</div><div class="h-value green" id="h-tipo">—</div>
      <div class="h-label">🏷️ INTAKE</div><div class="h-value code" id="h-intake">—</div>
      <div class="h-label">🏛️ FACULTAD</div><div class="h-value" id="h-facultad">—</div>
    </div>
    <img class="logo" src="https://res.cloudinary.com/dk53pztfo/image/upload/v1771043944/ChatGPT_Image_13_feb_2026_10_56_20_p.m._lf5z44.png" alt="Logo ETOP">
  </section>

  <section class="summary">
    <div class="summary-row">
      <div><div class="summary-title">Resumen de Cursos</div><div class="summary-sub" id="subtitle">ETOP · cargando cursos…</div></div>
      <div class="kpis">
        <div class="kpi" data-state="PREPARACION"><div class="kpi-v" style="color:#9bafc8" id="k-prep">0</div><div class="kpi-l">Prep.</div></div>
        <div class="kpi" data-state="ACTIVO"><div class="kpi-v" style="color:#75b79c" id="k-active">0</div><div class="kpi-l">Activos</div></div>
        <div class="kpi" data-state="EN CIERRE"><div class="kpi-v" style="color:#c8a06e" id="k-closing">0</div><div class="kpi-l">Cierre</div></div>
        <div class="kpi" data-state="CERRADO"><div class="kpi-v" style="color:#c88995" id="k-closed">0</div><div class="kpi-l">Cerrados</div></div>
        <div class="kpi total" data-state=""><div class="kpi-l">Total</div><div class="kpi-v" style="color:#d6e3f3" id="k-total">0</div></div>
      </div>
    </div>
    <div class="search-row"><span class="search-label">Buscar</span><input id="search" type="text" placeholder="NRC, curso, tutor…"><span id="count"></span><button class="btn-export" type="button" onclick="descargarExcel()">📥 Descargar Excel</button></div>
  </section>

  <div class="calendar-workspace">
    <div class="table-wrap">
      <table>
        <thead><tr><th class="sortable" data-sort="nrc">NRC_COD_CAL</th><th class="sortable" data-sort="estado">Estado</th><th class="sortable" data-sort="nombre curso">Nombre curso</th><th class="sortable" data-sort="facultad">Facultad</th><th class="sortable" data-sort="fecha inicio">F. inicio</th><th class="sortable" data-sort="fecha fin">F. fin</th><th class="sortable center" data-sort="semanas">Semanas</th><th class="sortable" data-sort="tutor">Tutor/a</th><th class="sortable" data-sort="tipo">Tipo</th><th class="sortable" data-sort="periodo">Periodo</th><th class="center">Acciones</th></tr></thead>
        <tbody id="rows"><tr><td colspan="11" class="empty">Cargando calendarios…</td></tr></tbody>
      </table>
    </div>
    <aside class="course-panel" id="course-panel" aria-label="Accesos del curso">
      <div id="course-panel-content"></div>
    </aside>
  </div>

  <script>
