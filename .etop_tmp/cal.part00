<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calendarios ETOP</title>
  <style>
    :root{--bg:#202733;--panel:#293340;--panel-soft:#252e3a;--line:#3a4552;--accent:#8192a8;--text:#d8dee7;--muted:#9aa7b7}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--text)}
    body{padding:12px;-webkit-font-smoothing:antialiased}.header{display:flex;justify-content:space-between;align-items:center;gap:22px;background:var(--panel-soft);border:1px solid var(--line);border-radius:9px;padding:12px 16px;margin-bottom:10px}
    .header-grid{display:grid;grid-template-columns:max-content minmax(120px,1fr) max-content minmax(120px,1fr);gap:7px 22px;font-size:11.5px;flex:1}.h-label{color:#919eae;font-weight:700}.h-value{color:var(--text);font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.h-value.up{text-transform:uppercase}.h-value.green{color:#9bbfaf}.h-value.code{color:#b8c4d2;font-family:monospace;font-weight:700}
    .logo{height:48px;object-fit:contain;max-width:175px;opacity:.88}.summary{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--line);padding:8px 0 10px;margin-bottom:6px}.summary-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:10px}.summary-title{font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#cbd3de}.summary-sub{font-size:10px;color:var(--muted);margin-top:2px}.kpis{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 14px;text-align:center;min-width:86px;cursor:pointer;transition:.15s}.kpi:hover{border-color:var(--accent);transform:translateY(-1px)}.kpi.selected{border-color:#a9b7c8;box-shadow:0 0 0 2px rgba(169,183,200,.1)}.kpi-v{font-size:18px;font-weight:700;font-family:monospace;line-height:1.15}.kpi-l{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}.kpi.total{border-color:#465362;text-align:right}.search-row{display:flex;gap:7px;align-items:center;justify-content:flex-end}.search-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}#search{font:12px "Segoe UI",sans-serif;padding:7px 10px;border:1px solid var(--line);border-radius:7px;width:280px;outline:none;color:var(--text);background:var(--panel-soft)}#search:focus{border-color:var(--accent)}#count{font-size:11px;color:var(--muted);margin-left:4px}
    .table-wrap{overflow:auto;max-height:calc(100vh - 225px);border:1px solid var(--line);border-radius:8px}table{width:100%;border-collapse:collapse;min-width:1240px}thead{position:sticky;top:0;z-index:2}th{padding:9px 8px;font-size:10px;font-weight:700;text-transform:uppercase;color:#aeb9c7;text-align:left;white-space:nowrap;background:#252e3a;border-bottom:1px solid #526071;border-right:1px solid rgba(255,255,255,.035)}th.sortable{cursor:pointer;user-select:none}th.sortable:hover{color:#d6dee8;background:#2d3744}th.sortable::after{content:' ↕';color:#6f7d8e}th.sortable[data-dir="asc"]::after{content:' ↑';color:#aebdd0}th.sortable[data-dir="desc"]::after{content:' ↓';color:#aebdd0}td{padding:9px 8px;font-size:12px;color:#c5cdd8;white-space:nowrap;border-bottom:1px solid rgba(93,107,123,.36)}tr{background:var(--bg)}tbody tr:nth-child(even){background:#222a35}tbody tr:hover{background:#2b3542}tr.closed{background:#242c37}.nrc{background:#2d3948;border-left:3px solid #72869e;padding:5px 8px;border-radius:4px;color:#c4cfdd;font-weight:700}.badge{font-size:9px;font-weight:700;padding:3px 8px;border-radius:9px}.prep{background:#3b3a32;color:#c2ae79}.active{background:#2e3d39;color:#9ebcae}.closing{background:#403832;color:#c1a083}.closed-b{background:#383238;color:#b79ca6}.unknown{background:#303946;color:#9aa7b7}.course{max-width:280px;overflow:hidden;text-overflow:ellipsis}.tutor{max-width:180px;overflow:hidden;text-overflow:ellipsis}.date{font-family:monospace;color:#b8c2cf}.center{text-align:center}.actions{display:flex;gap:6px;justify-content:center}.action{display:inline-flex;align-items:center;justify-content:center;min-width:29px;height:27px;padding:0 6px;border-radius:6px;text-decoration:none;background:#2d3846;border:1px solid #465363;color:#cbd4df;font-size:13px}.action:hover{border-color:#75869a;background:#354251}.powerapps-table{min-width:96px;font-size:10px;font-weight:800;cursor:pointer;font-family:inherit}.incident-ok{min-width:48px;background:#2d3c38;border-color:#49645b;color:#a9c7ba;font-size:10px;font-weight:800}.incident-alert{min-width:42px;background:#43363a;border-color:#73515a;color:#d3abb5;font-weight:800}.incident-count{display:inline-flex;align-items:center;justify-content:center;min-width:17px;height:17px;margin-left:3px;padding:0 4px;border-radius:9px;background:#8b5965;color:#f0dce1;font-size:10px}.empty{padding:42px;text-align:center;color:var(--muted);font-size:13px}.error{padding:30px;text-align:center;background:#2a303b;border:2px dashed #765a61;border-radius:8px;margin:15px;color:#caaeb5}
    /* Tema ETOP claro */
    :root{--bg:#eef2f7;--panel:#ffffff;--panel-soft:#f8fafc;--line:#d7e0ea;--accent:#d6a900;--text:#334155;--muted:#64748b}
    html,body{background:var(--bg);color:var(--text)}
    .header{background:#fff;border-color:#d7e0ea;border-top:3px solid #d6a900;box-shadow:0 2px 8px rgba(51,65,85,.045)}
    .h-label{color:#64748b}.h-value{color:#334155}.h-value.green{color:#27815e}.h-value.code{color:#52657a}.logo{opacity:.92}
    .summary{background:#eef2f7;border-bottom-color:#d7e0ea}.summary-title{color:#475569}.summary-sub{color:#64748b}
    .kpi{background:#fff;border-color:#d7e0ea;box-shadow:0 2px 7px rgba(51,65,85,.04)}
    .kpi:hover{border-color:#c9ad3d;box-shadow:0 4px 10px rgba(51,65,85,.07)}
    .kpi.selected{border-color:#d6a900;box-shadow:0 0 0 2px rgba(214,169,0,.12)}
    .kpi[data-state="PREPARACION"]{border-top:3px solid #6884a5}.kpi[data-state="ACTIVO"]{border-top:3px solid #27815e}.kpi[data-state="EN CIERRE"]{border-top:3px solid #b97721}.kpi[data-state="CERRADO"]{border-top:3px solid #a4515d}.kpi.total{border-top:3px solid #d6a900;text-align:right}
    #k-prep{color:#506f94!important}#k-active{color:#27815e!important}#k-closing{color:#9a6018!important}#k-closed{color:#a04452!important}#k-total{color:#334155!important}
    #search{color:#334155;background:#fff;border-color:#cbd5e1}#search:focus{border-color:#c6a000;box-shadow:0 0 0 3px rgba(214,169,0,.11)}
    .table-wrap{background:#fff;border-color:#d7e0ea;box-shadow:0 3px 10px rgba(51,65,85,.045)}
    th{color:#65778b;background:#e7edf5;border-bottom-color:#cbd5e1;border-right-color:#d7e0ea}
    th.sortable:hover{color:#334155;background:#dce5ef}th.sortable::after{color:#8b9aad}th.sortable[data-dir="asc"]::after,th.sortable[data-dir="desc"]: